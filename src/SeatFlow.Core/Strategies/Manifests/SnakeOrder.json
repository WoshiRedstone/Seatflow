{
    "id": "SnakeOrder",
    "name": "SnakeOrder",
    "displayName": "蛇形顺序",
    "version": "1.2.0",
    "manifestVersion": "1.0",
    "description": "按名单（导入表格）的原始顺序确定性填充空座：网格逐行蛇形（相邻行反向）、环形逐环交替方向；可关闭蛇形并设置起始方向。适合考场式排座等需要可预测顺序的场景。",
    "author": "SeatFlow Team",
    "category": "assignment",
    "defaultPriority": 10,
    "defaultEnabled": false,
    "visible": true,
    "parameters": [
        {
            "name": "SortDescending",
            "fieldType": "ToggleSwitch",
            "label": { "zh-CN": "倒序填充（名单末行优先）", "en-US": "Fill in reverse roster order (last row first)" },
            "defaultValue": false
        },
        {
            "name": "Serpentine",
            "fieldType": "ToggleSwitch",
            "label": { "zh-CN": "蛇形走向（关闭则逐行同向）", "en-US": "Serpentine order (off = same direction per row)" },
            "defaultValue": true
        },
        {
            "name": "Direction",
            "fieldType": "Dropdown",
            "label": { "zh-CN": "起始方向", "en-US": "Start direction" },
            "defaultValue": "Forward",
            "dropdownValues": ["Forward", "Reverse"],
            "dropdownLabels": {
                "Forward": { "zh-CN": "正向（左→右）", "en-US": "Forward (left→right)" },
                "Reverse": { "zh-CN": "反向（右→左）", "en-US": "Reverse (right→left)" }
            }
        }
    ],
    "codeBlocks": [],
    "messages": {
        "SnakeOrder_Assigned": {
            "zh-CN": "蛇形顺序已安排 {0} 名学生",
            "en-US": "Snake order assigned {0} students"
        }
    }
}
